# AgriGuru Environment Variables
# Rename this file to .env and fill in your API keys and configurations.

# --- Core AI & NLP ---
# OpenAI API Key (if using GPT-4 directly as mentioned in brief Section 2.1, or for any other OpenAI calls)
OPENAI_API_KEY=""

# Google Translate API Key (for multi-language support - Requires a Google Cloud Project with billing)
# Create a JSON key file for a service account with "Cloud Translation API" role.
# Then either set GOOGLE_APPLICATION_CREDENTIALS environment variable to its path,
# or load it specifically in language_support.py
# For simplicity, if a simple API key method is available for Translate, use this:
GOOGLE_TRANSLATE_API_KEY=""


# --- Weather Data ---
# OpenWeatherMap API Key (Brief Section 11.A)
OPENWEATHERMAP_API_KEY=""

# NASA POWER API Key (Often free, but key can provide higher rate limits)
NASA_POWER_API_KEY="YOUR_NASA_POWER_API_KEY_IF_NEEDED" # Usually no key needed for basic access.


# --- Satellite Data ---
# Sentinel Hub (OAuth Client ID and Secret - if using sentinelhub-py for Sentinel-2 data)
# (This is one common way to access Sentinel data programmatically)
SENTINEL_API_CLIENT_ID=""
SENTINEL_API_CLIENT_SECRET=""
# Note: Google Earth Engine (GEE) usually requires authentication via OAuth2 (gcloud auth application-default login)
# and a registered GEE account, not a simple API key in .env for direct `ee.Initialize()`.
# If you have a specific GEE service key JSON, you might set GOOGLE_APPLICATION_CREDENTIALS to its path.


# --- Market Data ---
# (These APIs might not exist or might not require keys; scraping is also mentioned)
AGMARKNET_API_KEY="" # If a key-based API for Agmarknet is found
GROWSTUFF_API_KEY=""  # If Growstuff provides an API key


# --- Local Weather Stations (Optional) ---
SENCROP_API_KEY="" # If integrating with Sencrop


# --- Database Configuration ---
# Default is SQLite. For PostgreSQL, set the full connection string.
# Example for SQLite (created in data/ folder):
DATABASE_URL="sqlite:///./data/agriguru_cache.db"
# Example for PostgreSQL:
# DATABASE_URL="postgresql://username:password@host:port/mydatabase"


# --- Cache Settings ---
CACHE_EXPIRY_HOURS="24"
OFFLINE_MODE_ENABLED="True" # True or False


# --- MQTT Broker Settings (for IoT & Edge Computing) ---
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT="1883"
MQTT_USERNAME="" # Optional
MQTT_PASSWORD="" # Optional
# MQTT_TLS_CERTFILE="" # Path to CA cert file for TLS, if used.


# --- Logging ---
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR, CRITICAL


# --- Model Paths (Examples - these will be created by training scripts) ---
# CROP_SUITABILITY_MODEL_PATH="./data/models/crop_suitability_model.joblib"
# YOLO_MODEL_PATH="./data/models/yolov8n_pest_detection.pt"
# HF_MODEL_CACHE_DIR="./data/models/hf_cache/" # Optional: To control where HuggingFace models are downloaded
